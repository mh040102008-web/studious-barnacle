
name: Build DeviceCare APK

on:
  push:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.11.1"

      - name: Extract project
        run: unzip -q DeviceCare_Android_Project.zip -d unpacked

      - name: Build APK
        working-directory: unpacked/DeviceCare
        run: gradle assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: devicecare-debug-apk
          path: unpacked/DeviceCare/app/build/outputs/apk/debug/app-debug.apk
